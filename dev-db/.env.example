# Dev-only credentials — never use in production.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=churn_dev

# Seed / admin (write access — dev-db seed container only)
CHURN_ADMIN_USER=churn_admin
CHURN_ADMIN_PASSWORD=churn_admin_dev

# datasynth read-only connection (copy into project root .env)
DATABASE_URL=postgresql+psycopg://datasynth_ro:datasynth_ro_dev@localhost:5433/churn_dev
